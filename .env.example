# Kopiere diese Datei nach .env und passe sie an.

# Port und Adresse des lokalen Webservers
PORT=3000
HOST=127.0.0.1

# Wie oft (Minuten) der Server die Feeds automatisch neu abruft
REFRESH_MINUTES=15

# --- Optional: KI-Zusammenfassungen -------------------------------------------
# Ohne Key zeigt das Dashboard automatisch eine extraktive Zusammenfassung
# (die zentralen Sätze aus den Teasern der Meldungen).
# Anbieter: auto | anthropic | openai | ollama | none
LLM_PROVIDER=auto
# LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OLLAMA_URL=http://localhost:11434
